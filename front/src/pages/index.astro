---
import Layout from '../layouts/Layout.astro';

const brazeroMenus = [
  {
      title: 'Menu Classique', price: '25,00€', unit: '/ pers',
      desc: 'Notre menu complet avec une sélection d\'apéritifs gourmands et viandes grillées au feu de bois.',
      modalDesc: 'Notre menu complet avec une sélection d\'apéritifs gourmands et viandes grillées au feu de bois. Une expérience gastronomique parfaite pour toutes vos réceptions. Préparé avec passion par notre équipe.',
      img: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?q=80&w=500',
      details: [
          { t: 'Apéritif', c: 'Planche de charcuterie, Cœur de canard persillé, Calamar à l\'Espagnole' },
          { t: 'Viande et accompagnement', c: 'Émincé d\'onglet de bœuf mariné à l\'échalote et au vin rouge, Suprême de poulet mariné au curry, Embeurrée de pomme de terre' },
          { t: 'Format', c: 'Minimum 20 personnes.' }
      ]
  },
  {
      title: 'Menu Gourmet', price: '30,00€', unit: '/ pers',
      desc: 'Une sélection exceptionnelle de viandes premium et d\'accompagnements raffinés pour vos événements spéciaux.',
      modalDesc: 'Une sélection exceptionnelle de viandes premium et d\'accompagnements raffinés pour vos événements spéciaux. Pour les amateurs de gastronomie qui ne font aucun compromis.',
      img: 'https://images.unsplash.com/photo-1544025162-831e5066c0de?q=80&w=500',
      details: [
          { t: 'Apéritif', c: 'Planche de charcuteries fines et fromages, Poivron de Padron à la fleur de sel, Cœur de canard persillé, Mini brochette aux crevettes et au chorizo' },
          { t: 'Viande et accompagnement', c: 'Onglet de boeuf émincé et mariné à l\'échalote, Araignée de porc marinée aux trois poivres, Écrasé de pommes de terre aux champignons et aux cèpes' },
          { t: 'Format', c: 'Minimum 20 personnes' }
      ]
  },
  {
      title: 'Menu Prestige', price: '35,00€', unit: '/ pers', desc: 'Produits nobles et cuissons signatures.',
      img: 'https://images.unsplash.com/photo-1594046306503-4f056241a46b?q=80&w=500',
      details: [
          { t: 'Apéritif', c: 'Croque-monsieur truffé, St-Jacques, Mini brochettes' },
          { t: 'Viande', c: 'Magret de canard, Émincé de bœuf mariné' },
          { t: 'Accompagnement', c: 'Pommes grenailles sautées' }
      ]
  },
  {
      title: 'Menu du Boucher', price: '60,00€', unit: '/ pers', desc: 'L\'expérience ultime des pièces d\'exception.',
      img: 'https://images.unsplash.com/photo-1603360946369-dc9bb6258143?q=80&w=500',
      details: [
          { t: 'Apéritif', c: 'Sélection d\'exceptions du Chef boucher' },
          { t: 'Viande', c: 'Côte de bœuf maturée, Pièces nobles de concours (Tomahawk...)' },
          { t: 'Accompagnement', c: 'Légumes grillés de saison & Pommes grenailles' }
      ]
  },
];

const traiteurItems = [
  {
    title: 'Planche Charcuterie', desc: 'Sélection artisanale traditionnelle', price: '4,50€', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1628268909376-e8c4dfebcd0d?q=80&w=500'
  },
  {
    title: 'Planche Mixte', desc: 'Charcuteries fines et fromages affinés', price: '5,50€', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1596568322646-0b1a0eac5bfa?q=80&w=500'
  },
  {
    title: 'Plaque Pizza/Quiche', desc: 'Idéale pour environ 50 pièces cocktails', price: '32,00€', unit: 'dès',
    img: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?q=80&w=500'
  },
  {
    title: 'Tapas & Anchois', desc: 'Pan con Tomate, jambon ou crevettes', price: '1,40€', unit: '/ pièce',
    img: 'https://images.unsplash.com/photo-1541529086526-db283c563270?q=80&w=500'
  },
  {
    title: 'Pièces Nobles', desc: 'Tapas Foie Gras, Saumon fumé maison', price: '1,70€', unit: '/ pièce',
    img: 'https://images.unsplash.com/photo-1644704381734-7a3c3182b810?q=80&w=500'
  },
  {
    title: 'Verrines Fraîcheur', desc: 'Rillettes de thon, passion, pétoncles...', price: '1,80€', unit: '/ pièce',
    img: 'https://images.unsplash.com/photo-1588673836336-d70c40608ed1?q=80&w=500'
  }
];

const carteAperitifs = [
  { name: 'Planche charcuterie',                  price: '4,50€' },
  { name: 'Planche charcuterie fromage',          price: '5,50€' },
  { name: 'Mini brochettes chorizo crevettes',    price: '5,90€' },
  { name: 'Cœur de canard persillés',             price: '5,90€' },
  { name: 'Poivron de Padron à la fleur de sel',  price: '2,90€' },
  { name: 'Calamar à l\'Espagnole',               price: '5,90€' },
  { name: 'Mini brochettes crevettes flambées',   price: '6,90€' },
  { name: 'Mini brochettes Noix de Saint-Jacques',price: '7,50€' },
  { name: 'Couteaux en persillade',               price: '5,90€' },
  { name: 'Moules de Bouchot en persillade',      price: '5,90€' },
];

const carteViandes = [
  { name: 'Émincé de bœuf vin rouge & échalote',  price: '9,90€' },
  { name: 'Émincé d\'onglet vin rouge & échalote', price: '10,90€' },
  { name: 'Suprême de poulet mariné',              price: '7,90€' },
  { name: 'Grilladin de dinde mariné',             price: '6,90€' },
  { name: 'Entrecôte ~400g',                       price: '18,90€' },
  { name: 'Araignée de porc marinée',              price: '8,90€' },
  { name: 'Pluma de porc marinée',                 price: '9,90€' },
  { name: 'Demi magret ~200g',                     price: '9,90€' },
  { name: 'Magret entier ~400g',                   price: '17,90€' },
  { name: 'Tomahawk de porc',                      price: 'Sur devis' },
  { name: 'Côte à l\'os',                          price: 'Sur devis' },
  { name: 'T-bone de bœuf',                        price: 'Sur devis' },
];
---

<Layout
  title="Boucherie Chez Guillaume — Boucher Traiteur à Montbeton, Tarn-et-Garonne (82)"
  description="Boucherie artisanale & traiteur événementiel à Montbeton (82). Formules Brazéro, plateaux traiteur pour mariages, anniversaires et réceptions. Devis gratuit."
  image="/images/team-boucherie.jpg"
>
  <!-- 1. HERO -->
  <section id="hero" class="min-h-[600px] md:min-h-[900px] flex items-center bg-[#151210] relative overflow-hidden pt-20 border-b border-white/5">
    <div class="absolute inset-0 z-0 opacity-40">
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center relative z-10 py-12 lg:py-0">

      <!-- Image avec parallaxe -->
      <div class="relative group flex justify-center order-2 lg:order-1" id="hero-image-col">
        <div class="relative w-[55%] md:w-[70%]" id="hero-parallax">
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[85%] h-[110%] border-[8px] border-primary z-0 transform rotate-[-2deg] reveal-fade"></div>
          <div class="relative z-10 transform hover:scale-105 transition-transform duration-700 reveal-scale">
            <img src="/images/steak-hero.png" alt="Côte de bœuf fraîche — Boucherie Chez Guillaume, Montbeton" class="w-full h-auto drop-shadow-[0_50px_50px_rgba(0,0,0,0.8)]" fetchpriority="high" />
          </div>
        </div>
      </div>

      <!-- Texte avec animations séquentielles -->
      <div class="text-white lg:pl-10 order-1 lg:order-2">
        <span class="section-label reveal-up" style="--delay:0ms">L'Art de la Viande</span>
        <h1 class="text-4xl md:text-6xl font-serif italic leading-[1.1] mb-8 reveal-up" style="--delay:120ms">
          Boucher Traiteur <br/>
          <span class="text-primary not-italic font-sans font-black uppercase text-3xl md:text-5xl tracking-tighter">pour vos événements <br/> dans le Tarn-et-Garonne</span>
        </h1>
        <p class="text-secondary text-lg md:text-xl leading-relaxed mb-12 max-w-xl font-light reveal-up" style="--delay:240ms">
          Boucherie d'exception & Traiteur événementiel. Nous sélectionnons, maturons et sublimons les meilleures pièces pour vos moments uniques.
        </p>
        <div class="flex flex-wrap gap-6 items-center reveal-up" style="--delay:360ms">
          <a href="#prestations" class="btn-primary">Découvrir nos cartes</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-[#0a0a0a] to-transparent"></div>
  </section>

  <!-- NOTRE HISTOIRE -->
  <section id="about" class="relative py-32 bg-[#0a0a0a] overflow-hidden">

    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[10%] left-[-10%] w-[50vw] h-[50vw] bg-[#8c3a2b] rounded-full mix-blend-screen filter blur-[150px] opacity-20"></div>
      <div class="absolute bottom-[10%] right-[-10%] w-[40vw] h-[40vw] bg-[#d48c2c] rounded-full mix-blend-screen filter blur-[150px] opacity-10"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">

      <div class="mb-20">
        <span class="section-label reveal-up" style="--delay:0ms">Notre Histoire</span>
        <div class="flex flex-col lg:flex-row lg:items-end gap-6 lg:gap-20">
          <h2 class="text-4xl md:text-5xl font-serif italic text-white leading-[1.1] tracking-tight reveal-up" style="--delay:100ms">
            Un savoir-faire<br/><span class="text-primary">artisanal</span>
          </h2>
          <div class="h-px bg-white/10 flex-grow mb-4 hidden lg:block reveal-fade" style="--delay:200ms"></div>
          <p class="text-secondary text-sm uppercase tracking-[0.3em] font-black lg:mb-4 reveal-up" style="--delay:200ms">Montbeton — Tarn-et-Garonne</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-28 items-start">

        <div class="space-y-8">
          <p class="text-white/80 text-lg leading-relaxed font-light reveal-up" style="--delay:150ms">
            Chez Guillaume perpétue un savoir-faire artisanal dans le respect des traditions. Installés à <strong class="text-white font-semibold">Montbeton dans le Tarn-et-Garonne</strong>, nous sélectionnons avec soin les meilleures viandes et matières premières auprès de producteurs locaux.
          </p>
          <p class="text-white/80 text-lg leading-relaxed font-light reveal-up" style="--delay:250ms">
            Notre équipe de bouchers, charcutiers et traiteurs passionnés travaille chaque jour pour vous offrir des produits de qualité et des <strong class="text-white font-semibold">prestations traiteurs sur mesure</strong> pour tous vos réceptions.
          </p>
          <p class="text-white/80 text-lg leading-relaxed font-light reveal-up" style="--delay:350ms">
            De la simple réception entre amis jusqu'au <strong class="text-white font-semibold">mariage de plusieurs centaines de convives</strong>, nous mettons notre expertise à votre service pour créer des moments de convivialité inoubliables autour de belles pièces de viandes.
          </p>
          <div class="pt-4 reveal-up" style="--delay:450ms">
            <a href="#prestations" class="btn-primary">Voir nos formules</a>
          </div>
        </div>

        <div class="reveal-scale overflow-hidden rounded-2xl" style="--delay:200ms">
          <img src="/images/team-boucherie.jpg" alt="L'équipe de la Boucherie Chez Guillaume à Montbeton, Tarn-et-Garonne" class="w-full h-full object-cover max-h-[520px]" loading="lazy" />
        </div>

      </div>
    </div>
  </section>

  <!-- UNIFIED PRESTATIONS SECTION WITH TABS -->
  <section id="prestations" class="relative py-24 overflow-hidden bg-[#0a0a0a]" x-data="{ activeTab: 'brazero', activeModal: null, brazeroSlide: 0, traiteurSlide: 0, carteSlide: 0, bTouchStartX: 0, tTouchStartX: 0, cTouchStartX: 0 }">

    <div class="absolute inset-0 opacity-20 pointer-events-none">
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/dark-wood.png')]"></div>
    </div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] bg-primary/5 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <span class="text-primary tracking-[0.3em] text-xs font-black uppercase inline-block border border-primary/30 px-6 py-2 rounded-full mb-6 bg-black/50 backdrop-blur-md reveal-up" style="--delay:0ms">Nos Prestations</span>
        <h2 class="text-3xl md:text-4xl font-serif italic text-white drop-shadow-xl mb-12 reveal-up" style="--delay:100ms">L'Excellence à <span class="text-primary">votre table</span></h2>

        <!-- TABS SWITCHER -->
        <div class="inline-flex p-1.5 bg-white/[0.03] border border-white/10 rounded-full backdrop-blur-2xl shadow-2xl">
           <button @click="activeTab = 'brazero'" :class="activeTab === 'brazero' ? 'bg-primary text-black shadow-lg scale-105' : 'text-white/60 hover:text-white'" class="px-8 py-3.5 rounded-full text-[11px] font-black uppercase tracking-widest transition-all duration-300">
              Formules Brazéro
           </button>
           <button @click="activeTab = 'traiteur'" :class="activeTab === 'traiteur' ? 'bg-primary text-black shadow-lg scale-105' : 'text-white/60 hover:text-white'" class="px-8 py-3.5 rounded-full text-[11px] font-black uppercase tracking-widest transition-all duration-300">
              Service Traiteur
           </button>
           <button @click="activeTab = 'carte'" :class="activeTab === 'carte' ? 'bg-primary text-black shadow-lg scale-105' : 'text-white/60 hover:text-white'" class="px-8 py-3.5 rounded-full text-[11px] font-black uppercase tracking-widest transition-all duration-300">
              À la Carte
           </button>
        </div>
      </div>

      <!-- TAB CONTENT: BRAZERO -->
      <div x-show="activeTab === 'brazero'" x-transition:enter="transition ease-out duration-500 delay-200" x-transition:enter-start="opacity-0 translate-y-8" x-transition:enter-end="opacity-100 translate-y-0">

        <!-- MOBILE CAROUSEL -->
        <div class="md:hidden">
          <div class="overflow-hidden -mx-6"
               @touchstart.passive="bTouchStartX = $event.touches[0].clientX"
               @touchend="if($event.changedTouches[0].clientX - bTouchStartX < -50 && brazeroSlide < 3) brazeroSlide++; else if($event.changedTouches[0].clientX - bTouchStartX > 50 && brazeroSlide > 0) brazeroSlide--">
            <div class="flex" :style="'transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); transform: translateX(calc(7.5vw - ' + brazeroSlide + ' * (85vw + 16px)))'">
              {brazeroMenus.map((menu, index) => (
                <div class="w-[85vw] shrink-0 mr-4">
                  <div @click={`activeModal = ${index}`} class="relative bg-white/[0.04] backdrop-blur-[30px] border border-white/10 rounded-[40px] p-6 shadow-[0_20px_50px_rgba(0,0,0,0.3)] cursor-pointer hover:border-primary/50 transition-all duration-500 flex flex-col group h-full">
                    <div class="w-full flex justify-center mb-6 mt-4">
                      <div class="w-28 h-28 rounded-full overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.5)] border-[4px] border-black/20">
                        <img src={menu.img} alt={menu.title} class="w-full h-full object-cover" loading="lazy" />
                      </div>
                    </div>
                    <div class="text-center px-1 flex-grow">
                      <h3 class="text-lg font-bold text-white tracking-wide mb-1 leading-tight">{menu.title}</h3>
                      <p class="text-white/50 text-[10px] font-light leading-relaxed h-12 overflow-hidden">{menu.desc}</p>
                    </div>
                    <div class="mt-6 flex justify-between items-center pt-5 border-t border-white/10">
                      <span class="text-lg font-serif italic text-primary">{menu.price}</span>
                      <button class="bg-white/10 group-hover:bg-primary font-bold text-white text-[9px] px-3 py-2 flex items-center rounded-full transition-colors shadow-lg pointer-events-none uppercase tracking-tighter">
                        Détails <svg class="w-3 h-3 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <!-- Dots -->
          <div class="flex justify-center items-center gap-2 mt-6">
            {brazeroMenus.map((_, i) => (
              <button
                @click={`brazeroSlide = ${i}`}
                :class={`brazeroSlide === ${i} ? 'w-5 bg-primary' : 'w-1.5 bg-white/20'`}
                class="h-1.5 rounded-full transition-all duration-300"
              ></button>
            ))}
          </div>
        </div>

        <!-- DESKTOP GRID -->
        <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {brazeroMenus.map((menu, index) => (
            <div class="h-full">
              <div @click={`activeModal = ${index}`} class="relative bg-white/[0.04] backdrop-blur-[30px] border border-white/10 rounded-[40px] p-6 shadow-[0_20px_50px_rgba(0,0,0,0.3)] cursor-pointer hover:-translate-y-3 hover:shadow-[0_40px_60px_rgba(0,0,0,0.5)] hover:border-primary/50 transition-all duration-500 flex flex-col group h-full">
                <div class="w-full flex justify-center mb-6 mt-4 relative">
                  <div class="w-28 h-28 rounded-full overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.5)] border-[4px] border-black/20 group-hover:scale-105 group-hover:rotate-6 transition-transform duration-700">
                    <img src={menu.img} alt={menu.title} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                </div>
                <div class="text-center px-1 flex-grow">
                  <h3 class="text-lg font-bold text-white tracking-wide mb-1 leading-tight">{menu.title}</h3>
                  <p class="text-white/50 text-[10px] font-light leading-relaxed h-12 overflow-hidden">{menu.desc}</p>
                </div>
                <div class="mt-6 flex justify-between items-center pt-5 border-t border-white/10">
                  <span class="text-lg font-serif italic text-primary">{menu.price}</span>
                  <button class="bg-white/10 group-hover:bg-primary font-bold text-white text-[9px] px-3 py-2 flex items-center rounded-full transition-colors shadow-lg pointer-events-none uppercase tracking-tighter">
                    Détails <svg class="w-3 h-3 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- TAB CONTENT: TRAITEUR -->
      <div x-show="activeTab === 'traiteur'" x-transition:enter="transition ease-out duration-500 delay-300" x-transition:enter-start="opacity-0 translate-y-8" x-transition:enter-end="opacity-100 translate-y-0">

        <!-- MOBILE CAROUSEL -->
        <div class="md:hidden">
          <div class="overflow-hidden -mx-6"
               @touchstart.passive="tTouchStartX = $event.touches[0].clientX"
               @touchend="if($event.changedTouches[0].clientX - tTouchStartX < -50 && traiteurSlide < 5) traiteurSlide++; else if($event.changedTouches[0].clientX - tTouchStartX > 50 && traiteurSlide > 0) traiteurSlide--">
            <div class="flex" :style="'transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); transform: translateX(calc(7.5vw - ' + traiteurSlide + ' * (85vw + 16px)))'">
              {traiteurItems.map((item) => (
                <div class="w-[85vw] shrink-0 mr-4">
                  <div class="relative bg-white/[0.04] backdrop-blur-[30px] border border-white/10 rounded-[40px] p-8 shadow-[0_20px_50px_rgba(0,0,0,0.3)] hover:border-white/20 transition-all duration-500 flex flex-col group h-full">
                    <div class="w-full flex justify-center mb-6 mt-2">
                      <div class="w-32 h-32 rounded-full overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.5)] border-[6px] border-black/20">
                        <img src={item.img} alt={`${item.title} — Traiteur Boucherie Chez Guillaume`} class="w-full h-full object-cover" loading="lazy" />
                      </div>
                    </div>
                    <div class="text-center px-2 flex-grow">
                      <h3 class="text-xl font-bold text-white tracking-wide mb-2">{item.title}</h3>
                      <p class="text-white/50 text-sm font-light leading-relaxed">{item.desc}</p>
                    </div>
                    <div class="mt-6 flex justify-between items-center pt-5 border-t border-white/10">
                      <div class="flex items-baseline gap-1">
                        <span class="text-xl font-serif italic text-primary">{item.price}</span>
                        <span class="text-[10px] text-white/60 lowercase">{item.unit}</span>
                      </div>
                      <a href="/devis" class="bg-black/80 hover:bg-primary font-bold text-white text-[10px] px-5 py-3 rounded-full border border-white/5 transition-colors uppercase tracking-widest shadow-lg">Demander</a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <!-- Dots -->
          <div class="flex justify-center items-center gap-2 mt-6">
            {traiteurItems.map((_, i) => (
              <button
                @click={`traiteurSlide = ${i}`}
                :class={`traiteurSlide === ${i} ? 'w-5 bg-primary' : 'w-1.5 bg-white/20'`}
                class="h-1.5 rounded-full transition-all duration-300"
              ></button>
            ))}
          </div>
        </div>

        <!-- DESKTOP GRID -->
        <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {traiteurItems.map((item) => (
            <div class="relative bg-white/[0.04] backdrop-blur-[30px] border border-white/10 rounded-[40px] p-8 shadow-[0_20px_50px_rgba(0,0,0,0.3)] hover:-translate-y-3 hover:shadow-[0_40px_60px_rgba(0,0,0,0.5)] hover:border-white/20 transition-all duration-500 flex flex-col group">
              <div class="w-full flex justify-center mb-8 mt-2 relative">
                <div class="w-40 h-40 rounded-full overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.5)] border-[6px] border-black/20 group-hover:scale-105 group-hover:rotate-3 transition-transform duration-700">
                  <img src={item.img} alt={`${item.title} — Traiteur Boucherie Chez Guillaume`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              </div>
              <div class="text-center px-2 flex-grow">
                <h3 class="text-2xl font-bold text-white tracking-wide mb-2">{item.title}</h3>
