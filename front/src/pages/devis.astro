  <script is:inline>
    function devisApp() {
      const D = window.__D__;
      return {
        tab: 'form', step: 1, submitted: false, D,

        /* form */
        ev:  { type:'', date:'', guests:'', lieu:'', note:'' },
        brazero: null,
        openDetail: null,
        step2tab: 'brasero',
        carte: { ap:[], vi:[] },
        tsel: {},
        ct: { prenom:'', nom:'', email:'', tel:'' },

        /* admin */
        adminPwd:'', adminAuth:false, adminErr:false,
        list:[], openD:null, aFilter:'all',

        init() { this.loadDevis(); },

        goStep(s) { if (s < this.step) { this.step = s; this.scrollToForm(); } },
        scrollToForm() {
          this.$nextTick(() => {
            const el = document.getElementById('form-top');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        },

        /* brazero */
        pickBrazero(id) {
          if (this.brazero === id) { this.brazero = null; }
          else { this.brazero = id; this.openDetail = id; }
        },

        /* à la carte */
        toggleCarte(cat, id) {
          const arr = this.carte[cat];
          const i = arr.indexOf(id);
          i === -1 ? arr.push(id) : arr.splice(i, 1);
        },
        hasCarte() { return this.carte.ap.length > 0 || this.carte.vi.length > 0; },

        /* traiteur */
        toggleT(id) { this.tsel[id] = !this.tsel[id]; },
        hasT() { return Object.values(this.tsel).some(v => v); },
        hasSurDevisT() { return D.traiteurItems.filter(it => it.surDevis).some(it => this.tsel[it.id]); },
        hasForfait() { return D.traiteurItems.filter(it => !it.surDevis && it.unit !== 'pers').some(it => this.tsel[it.id]); },
        totalForfait() {
          let t = 0;
          D.traiteurItems.filter(it => !it.surDevis && it.unit !== 'pers').forEach(it => { if (this.tsel[it.id]) t += it.price; });
          return t;
        },
        tLineTotal(item) {
          if (item.surDevis || !this.tsel[item.id]) return 0;
          return item.price;
        },

        /* recap */
        brazeroName() {
          const m = D.brazeroMenus.find(m => m.id === this.brazero);
          return m ? m.title : '';
        },
        brazeroTotal() {
          const m = D.brazeroMenus.find(m => m.id === this.brazero);
          if (!m || m.priceNum === 0) return 'Sur devis';
          return this.fPricePP(m.priceNum) + ' / pers';
        },
        carteName(cat, id) {
          const src = cat==='ap' ? D.carteAperitifs : D.carteViandes;
          const it = src.find(i=>i.id===id); return it ? it.name : '';
        },
        carteLineTotal(cat, id) {
          const src = cat==='ap' ? D.carteAperitifs : D.carteViandes;
          const it = src.find(i=>i.id===id);
          if (!it || it.unit==='devis') return 'Sur devis';
          return this.fPricePP(it.price) + ' / pers';
        },
        hasCarteDevis() {
          return this.carte.vi.some(id => { const it = D.carteViandes.find(i=>i.id===id); return it && it.unit==='devis'; });
        },
        /* prix par personne = brazero + carte */
        ppBase() {
          let pp = 0;
          if (this.brazero) {
            const m = D.brazeroMenus.find(m=>m.id===this.brazero);
            if (m && m.priceNum > 0) pp += m.priceNum;
          }
          this.carte.ap.forEach(id => { const it=D.carteAperitifs.find(i=>i.id===id); if(it) pp+=it.price; });
          this.carte.vi.forEach(id => { const it=D.carteViandes.find(i=>i.id===id); if(it && it.unit!=='devis') pp+=it.price; });
          D.traiteurItems.filter(it=>!it.surDevis && it.unit==='pers').forEach(it => { if (this.tsel[it.id]) pp += it.price; });
          return pp;
        },
        totalPP() {
          const pp = this.ppBase();
          if (pp === 0 && !this.hasSurDevisT() && !this.hasCarteDevis() && !this.hasForfait()) return '—';
          if (pp === 0) return 'Sur devis';
          return this.fPricePP(pp) + ' / pers';
        },
        total() { return this.totalPP(); },
        fPrice(n) {
          return new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n);
        },
        fPricePP(n) {
          return new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2}).format(n);
        },
        fDate(d) {
          if (!d) return '—';
          try { return new Date(d+'T00:00:00').toLocaleDateString('fr-FR',{day:'2-digit',month:'long',year:'numeric'}); }
          catch(e) { return d; }
        },

        ok1() { return this.ev.type && this.ev.date && this.ev.guests > 0 && this.ev.lieu; },
        ok2() { return !!this.brazero || this.hasT() || this.hasCarte(); },
        ok3() { return this.ct.prenom && this.ct.nom && this.ct.email && this.ct.tel; },

        async submit() {
          if (!this.ok3()) return;
          const m = D.brazeroMenus.find(m=>m.id===this.brazero);

          // Sauvegarde locale (back office simple)
          const entry = {
            id: Date.now().toString(),
            createdAt: new Date().toISOString(),
            status: 'pending',
            ev: { ...this.ev },
            brazero: m ? m.title : null,
            carteAp: this.carte.ap.map(id => this.carteName('ap',id)),
            carteVi: this.carte.vi.map(id => this.carteName('vi',id)),
            traiteur: D.traiteurItems.filter(it=>this.tsel[it.id]).map(it=>({ name:it.name })),
            ct: { ...this.ct },
            estimatif: this.ppBase() > 0 ? this.fPricePP(this.ppBase())+'/pers' : 'Sur devis',
            note: '',
          };
          const saved = JSON.parse(localStorage.getItem('chezgu_devis')||'[]');
          saved.unshift(entry);
          localStorage.setItem('chezgu_devis', JSON.stringify(saved));

          // Construire le payload pour l'API Symfony
          const options = [];
          if (m) {
            options.push({ slug: m.id, label: m.title, prix_base: m.priceNum, unite: 'par_personne' });
          }
          this.carte.ap.forEach(id => {
            const item = D.carteAperitifs.find(a => a.id === id);
            if (item) options.push({ slug: item.id, label: item.name, prix_base: item.price, unite: 'par_personne' });
          });
          this.carte.vi.forEach(id => {
            const item = D.carteViandes.find(v => v.id === id);
            if (item) options.push({ slug: item.id, label: item.name, prix_base: item.price, unite: 'par_personne' });
          });
          D.traiteurItems.filter(it => this.tsel[it.id]).forEach(it => {
            options.push({ slug: it.id, label: it.name, prix_base: it.price, unite: it.surDevis ? 'sur_devis' : (it.unit === 'pers' ? 'par_personne' : 'forfait') });
          });

          const prestSlug = this.brazero ? 'brasero' : (this.hasCarte() ? 'carte' : 'traiteur');
          const apiPayload = {
            prestation_slug: prestSlug,
            nb_personnes: parseInt(this.ev.guests) || 1,
            client_nom: this.ct.nom,
            client_prenom: this.ct.prenom,
            client_email: this.ct.email,
            client_telephone: this.ct.tel,
            date_evenement: this.ev.date || null,
            lieu: 'a_definir',
            lieu_detail: this.ev.lieu || '',
            client_message: [this.ev.type ? 'Événement : ' + this.ev.type : '', this.ev.note || ''].filter(Boolean).join('\n'),
            options,
          };

          try {
            const res = await fetch('https://admin.boucheriechezguillaume.fr/api/devis', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(apiPayload),
            });
            if (!res.ok) console.warn('API erreur', res.status);
          } catch(e) {
            console.warn('API indisponible, devis sauvegardé localement.', e);
          }

          this.submitted = true;
        },

        resetForm() {
          this.submitted=false; this.step=1; this.step2tab='brasero';
          this.ev={type:'',date:'',guests:'',lieu:'',note:''};
          this.brazero=null; this.openDetail=null;
          this.carte={ap:[],vi:[]};
          this.tsel={};
          this.ct={prenom:'',nom:'',email:'',tel:''};
        },

        /* admin */
        checkAdmin() {
          if (this.adminPwd==='Guillaume82') { this.adminAuth=true; this.adminErr=false; this.loadDevis(); }
          else this.adminErr=true;
        },
        loadDevis() { this.list = JSON.parse(localStorage.getItem('chezgu_devis')||'[]'); },
        saveList() { localStorage.setItem('chezgu_devis', JSON.stringify(this.list)); },
        openDevis(d) {
          if (this.openD===d.id) { this.openD=null; return; }
          this.openD=d.id;
          if (d.status==='pending') { d.status='read'; this.saveList(); }
        },
        setStatus(d,s) { d.status=s; this.saveList(); },
        delDevis(id) {
          if(!confirm('Supprimer ce devis ?')) return;
          this.list=this.list.filter(d=>d.id!==id); this.saveList();
          if(this.openD===id) this.openD=null;
        },
        filteredList() {
          const l = this.aFilter==='all' ? this.list : this.list.filter(d=>d.status===this.aFilter);
          return l.slice().sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
        },
        sLabel(s) {
          return {pending:'En attente',read:'Lu',responded:'Répondu',accepted:'Accepté'}[s]||s;
        },
      };
    }
  </script>
</Layout>
