---
import Layout from '../layouts/Layout.astro';

const brazeroMenus = [
  {
    id: 'classique', title: 'Menu Classique', priceNum: 25, price: '25,00 €', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?q=80&w=500',
    desc: 'Apéritifs gourmands et viandes grillées au feu de bois.',
    details: [
      { t: 'Apéritif', c: 'Planche de charcuterie · Cœur de canard persillé · Calamar à l\'Espagnole' },
      { t: 'Viande & accompagnement', c: 'Émincé d\'onglet de bœuf mariné à l\'échalote et au vin rouge · Suprême de poulet mariné au curry · Embeurrée de pomme de terre' },
      { t: 'Format', c: 'Minimum 20 personnes' },
    ]
  },
  {
    id: 'gourmet', title: 'Menu Gourmet', priceNum: 30, price: '30,00 €', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1544025162-831e5066c0de?q=80&w=500',
    desc: 'Viandes premium et accompagnements raffinés pour vos événements spéciaux.',
    details: [
      { t: 'Apéritif', c: 'Planche charcuteries fines et fromages · Poivron de Padron à la fleur de sel · Cœur de canard persillé · Mini brochette aux crevettes et au chorizo' },
      { t: 'Viande & accompagnement', c: 'Onglet de bœuf émincé et mariné à l\'échalote · Araignée de porc marinée aux trois poivres · Écrasé de pommes de terre aux champignons et cèpes' },
      { t: 'Format', c: 'Minimum 20 personnes' },
    ]
  },
  {
    id: 'prestige', title: 'Menu Prestige', priceNum: 35, price: '35,00 €', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1594046306503-4f056241a46b?q=80&w=500',
    desc: 'Produits nobles et cuissons signatures.',
    details: [
      { t: 'Apéritif', c: 'Croque-monsieur truffé · Saint-Jacques · Mini brochettes' },
      { t: 'Viande', c: 'Magret de canard · Émincé de bœuf mariné' },
      { t: 'Accompagnement', c: 'Pommes grenailles sautées' },
    ]
  },
  {
    id: 'boucher', title: 'Menu du Boucher', priceNum: 60, price: '60,00 €', unit: '/ pers',
    img: 'https://images.unsplash.com/photo-1603360946369-dc9bb6258143?q=80&w=500',
    desc: 'L\'expérience ultime des pièces d\'exception.',
    details: [
      { t: 'Apéritif', c: 'Sélection d\'exceptions du Chef boucher' },
      { t: 'Viande', c: 'Côte de bœuf maturée · Pièces nobles (Tomahawk…)' },
      { t: 'Accompagnement', c: 'Légumes grillés de saison & Pommes grenailles' },
    ]
  },
];

const carteAperitifs = [
  { id: 'char',     name: 'Planche charcuterie',                      price: 4.50 },
  { id: 'charfro',  name: 'Planche charcuterie fromage',              price: 5.50 },
  { id: 'brochcrev',name: 'Mini brochettes chorizo crevettes',        price: 5.90 },
  { id: 'canard',   name: 'Cœur de canard persillés',                 price: 5.90 },
  { id: 'padron',   name: 'Poivron de Padron à la fleur de sel',      price: 2.90 },
  { id: 'calamar',  name: 'Calamar à l\'Espagnole',                   price: 5.90 },
  { id: 'crevflam', name: 'Mini brochettes crevettes flambées',       price: 6.90 },
  { id: 'stjacq',   name: 'Mini brochettes Noix de Saint-Jacques',    price: 7.50 },
  { id: 'couteaux', name: 'Couteaux en persillade',                   price: 5.90 },
  { id: 'moules',   name: 'Moules de Bouchot en persillade',          price: 5.90 },
];

const carteViandes = [
  { id: 'boeuf',    name: 'Émincé de bœuf vin rouge & échalote',      price: 9.90,  unit: 'pers' },
  { id: 'onglet',   name: 'Émincé d\'onglet vin rouge & échalote',    price: 10.90, unit: 'pers' },
  { id: 'poulet',   name: 'Suprême de poulet mariné',                  price: 7.90,  unit: 'pers' },
  { id: 'dinde',    name: 'Grilladin de dinde mariné',                 price: 6.90,  unit: 'pers' },
  { id: 'entrecote',name: 'Entrecôte ~400g',                          price: 18.90, unit: 'pers' },
  { id: 'araignee', name: 'Araignée de porc marinée',                  price: 8.90,  unit: 'pers' },
  { id: 'pluma',    name: 'Pluma de porc marinée',                     price: 9.90,  unit: 'pers' },
  { id: 'demimag',  name: 'Demi magret ~200g',                         price: 9.90,  unit: 'pers' },
  { id: 'magret',   name: 'Magret entier ~400g',                       price: 17.90, unit: 'pers' },
  { id: 'tomahawk', name: 'Tomahawk de porc',                          price: 0,     unit: 'devis' },
  { id: 'coteOS',   name: 'Côte à l\'os',                             price: 0,     unit: 'devis' },
  { id: 'tbone',    name: 'T-bone de bœuf',                            price: 0,     unit: 'devis' },
];

const traiteurItems = [
  { id: 'planchar', name: 'Planche Charcuterie',  desc: 'Sélection artisanale traditionnelle',    price: 4.50, unit: 'pers',  surDevis: false, img: 'https://images.unsplash.com/photo-1628268909376-e8c4dfebcd0d?q=80&w=400' },
  { id: 'planmix',  name: 'Planche Mixte',         desc: 'Charcuteries fines et fromages affinés', price: 5.50, unit: 'pers',  surDevis: false, img: 'https://images.unsplash.com/photo-1596568322646-0b1a0eac5bfa?q=80&w=400' },
  { id: 'pizza',    name: 'Plaque Pizza / Quiche', desc: '~50 pièces cocktail par plaque',          price: 32,   unit: 'plaque', surDevis: false, img: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?q=80&w=400' },
  { id: 'tapas',    name: 'Tapas & Anchois',        desc: 'Pan con Tomate, jambon ou crevettes',    price: 0,    unit: 'pièce',  surDevis: true,  img: 'https://images.unsplash.com/photo-1541529086526-db283c563270?q=80&w=400' },
  { id: 'nobles',   name: 'Pièces Nobles',          desc: 'Foie Gras, Saumon fumé maison',          price: 0,    unit: 'pièce',  surDevis: true,  img: 'https://images.unsplash.com/photo-1644704381734-7a3c3182b810?q=80&w=400' },
  { id: 'verrines', name: 'Verrines Fraîcheur',     desc: 'Rillettes de thon, passion, pétoncles…', price: 0,   unit: 'pièce',  surDevis: true,  img: 'https://images.unsplash.com/photo-1588673836336-d70c40608ed1?q=80&w=400' },
];

const eventTypes = ['Mariage','Anniversaire','Séminaire','Repas de famille','Barbecue','Cocktail','Repas d\'entreprise','Autre'];
---

<Layout
  title="Demander un devis traiteur — Boucherie Chez Guillaume"
  description="Simulez et envoyez votre demande de devis pour un Brazéro ou une prestation traiteur sur mesure. Mariages, anniversaires, repas d'entreprise en Tarn-et-Garonne."
>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer is:inline></script>
  <script is:inline define:vars={{ brazeroMenus, carteAperitifs, carteViandes, traiteurItems, eventTypes }}>
    window.__D__ = { brazeroMenus, carteAperitifs, carteViandes, traiteurItems, eventTypes };
  </script>

  <div x-data="devisApp()" class="min-h-screen bg-dark pt-28 pb-24">
    <div class="max-w-7xl mx-auto px-6">

      <!-- ── TAB BAR ── -->
      <div class="flex items-center gap-0 mb-14 border border-white/10 w-fit">
        <button @click="tab='form'"
          :class="tab==='form' ? 'bg-primary text-dark' : 'text-white/50 hover:text-white'"
          class="px-8 py-3 text-[10px] uppercase font-black tracking-[0.3em] transition-all duration-200">
          Composer mon devis
        </button>
      </div>


      <!-- ══════════════════════════════════════════════════
           TAB FORMULAIRE
      ═════════════════════════════════════════════════════ -->
      <div x-show="tab==='form'" x-transition>

        <!-- SUCCESS -->
        <div x-show="submitted" class="text-center py-24">
          <div class="w-24 h-24 bg-primary/10 border border-primary/30 flex items-center justify-center mx-auto mb-8">
            <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span class="section-label block text-center">Demande envoyée</span>
          <h2 class="text-4xl md:text-6xl font-serif italic mb-6">Merci pour votre confiance</h2>
          <p class="text-secondary max-w-xl mx-auto mb-12 leading-relaxed">Guillaume vous contactera dans les 24h pour finaliser votre devis et répondre à toutes vos questions.</p>
          <button @click="resetForm()" class="btn-primary">Nouvelle demande</button>
        </div>

        <!-- STEPPER FORM -->
        <div x-show="!submitted">

          <div class="mb-12">
            <span class="section-label">Votre projet</span>
            <h1 class="section-title">Composez votre <span class="text-primary not-italic font-sans font-black uppercase text-3xl md:text-5xl tracking-tighter">devis sur mesure</span></h1>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-14 items-start">

            <!-- ─── FORM COLUMN ───────────────────────────── -->
            <div>

              <!-- Progress stepper -->
              <div id="form-top" class="flex items-center mb-12">
                <template x-for="s in [1,2,3]" :key="s">
                  <div class="flex items-center">
                    <button @click="goStep(s)"
                      class="w-9 h-9 flex items-center justify-center text-[11px] font-black transition-all duration-300 shrink-0"
                      :class="step > s ? 'bg-primary text-dark cursor-pointer' : step === s ? 'bg-primary text-dark' : 'bg-surface-2 text-white/30 cursor-default'">
                      <span x-show="step > s">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span x-show="step <= s" x-text="s"></span>
                    </button>
                    <div x-show="s < 3" class="h-px w-16 md:w-24 transition-all duration-500"
                      :class="step > s ? 'bg-primary' : 'bg-white/10'"></div>
                  </div>
                </template>
                <div class="ml-5">
                  <div class="text-[11px] font-black uppercase tracking-[0.3em] text-white"
                    x-text="['','Votre événement','Vos prestations','Vos coordonnées'][step]"></div>
                  <div class="text-[10px] text-white/30 mt-0.5"
                    x-text="'Étape '+step+' sur 3'"></div>
                </div>
              </div>

              <!-- ──────────────────────────────────────────
                   STEP 1 — Événement
              ─────────────────────────────────────────── -->
              <div x-show="step===1"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 translate-x-6"
                x-transition:enter-end="opacity-100 translate-x-0">
                <div class="space-y-8">

                  <div>
                    <label class="f-label">Type d'événement</label>
                    <div class="flex flex-wrap gap-2">
                      <template x-for="t in D.eventTypes" :key="t">
                        <button @click="ev.type = t"
                          :class="ev.type===t ? 'border-primary bg-primary/10 text-primary' : 'border-white/10 text-white/50 hover:border-white/25 hover:text-white'"
                          class="border px-4 py-2 text-[10px] uppercase font-black tracking-[0.2em] transition-all duration-150"
                          x-text="t"></button>
                      </template>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label class="f-label">Date souhaitée</label>
                      <input type="date" x-model="ev.date" class="f-input" />
                    </div>
                    <div>
                      <label class="f-label">Nombre de convives</label>
                      <input type="number" x-model.number="ev.guests" min="1" placeholder="ex : 80" class="f-input placeholder-white/20" />
                    </div>
                  </div>

                  <div>
                    <label class="f-label">Lieu de l'événement</label>
                    <input type="text" x-model="ev.lieu" placeholder="Ville, salle, domaine…" class="f-input placeholder-white/20" />
                  </div>

                  <div>
                    <label class="f-label">Informations complémentaires <span class="text-white/25 normal-case font-normal">(optionnel)</span></label>
                    <textarea x-model="ev.note" rows="3" placeholder="Allergies, thème, ambiance souhaitée…" class="f-input resize-none placeholder-white/20"></textarea>
                  </div>

                  <div class="flex justify-end pt-2">
                    <button @click="if(ok1()){step=2;scrollToForm()}" :disabled="!ok1()"
                      :class="ok1() ? 'btn-primary' : 'btn-primary opacity-30 cursor-not-allowed'">
                      Continuer →
                    </button>
                  </div>
                </div>
              </div>

              <!-- ──────────────────────────────────────────
                   STEP 2 — Prestations
              ─────────────────────────────────────────── -->
              <div x-show="step===2"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 translate-x-6"
                x-transition:enter-end="opacity-100 translate-x-0">
                <div class="space-y-8">

                  <!-- Sub-tab navigation -->
                  <div class="flex items-center gap-0 border border-white/10 w-fit flex-wrap">
                    <button @click="step2tab='brasero'"
                      :class="step2tab==='brasero' ? 'bg-primary text-dark' : 'text-white/50 hover:text-white'"
                      class="px-5 py-2.5 text-[9px] uppercase font-black tracking-[0.3em] transition-all duration-200">
                      Braséro &amp; Grill
                    </button>
                    <button @click="step2tab='traiteur'"
                      :class="step2tab==='traiteur' ? 'bg-primary text-dark' : 'text-white/50 hover:text-white'"
                      class="px-5 py-2.5 text-[9px] uppercase font-black tracking-[0.3em] transition-all duration-200">
                      Extras Traiteur
                    </button>
                    <button @click="step2tab='carte'"
                      :class="step2tab==='carte' ? 'bg-primary text-dark' : 'text-white/50 hover:text-white'"
                      class="px-5 py-2.5 text-[9px] uppercase font-black tracking-[0.3em] transition-all duration-200">
                      À la Carte
                    </button>
                  </div>

                  <!-- TAB: Braséro & Grill -->
                  <div x-show="step2tab==='brasero'">
                    <p class="text-white/35 text-xs mb-6">Prix par personne · service &amp; matériel inclus · choisissez une formule</p>
                    <div class="space-y-3">
                      <template x-for="menu in D.brazeroMenus" :key="menu.id">
                        <div class="border transition-all duration-200 overflow-hidden"
                          :class="brazero===menu.id ? 'border-primary/50' : 'border-white/10 hover:border-white/20'">
                          <button @click="pickBrazero(menu.id)" class="w-full flex items-center gap-4 p-4 text-left">
                            <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 border-2 transition-colors duration-200"
                              :class="brazero===menu.id ? 'border-primary' : 'border-white/10'">
                              <img :src="menu.img" :alt="menu.title" class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-grow min-w-0">
                              <div class="flex items-center gap-2.5 mb-0.5">
                                <div class="w-4 h-4 border-2 rounded-full flex items-center justify-center shrink-0 transition-colors duration-200"
                                  :class="brazero===menu.id ? 'border-primary' : 'border-white/20'">
                                  <div class="w-2 h-2 rounded-full bg-primary transition-all duration-200"
                                    :class="brazero===menu.id ? 'opacity-100 scale-100' : 'opacity-0 scale-0'"></div>
                                </div>
                                <span class="font-black text-white text-sm" x-text="menu.title"></span>
                              </div>
                              <p class="text-white/35 text-[11px] pl-[26px] leading-snug" x-text="menu.desc"></p>
                            </div>
                            <div class="text-right shrink-0 ml-2">
                              <div class="font-black text-base transition-colors duration-200"
                                :class="brazero===menu.id ? 'text-primary' : 'text-white/50'"
                                x-text="menu.priceNum > 0 ? menu.price : 'Sur devis'"></div>
                              <div class="text-[10px] text-white/25" x-text="menu.unit"></div>
                            </div>
                            <div @click.stop="openDetail===menu.id ? openDetail=null : openDetail=menu.id"
                              class="shrink-0 ml-1 p-1 hover:text-primary transition-colors">
                              <svg class="w-4 h-4 text-white/20 transition-transform duration-200"
                                :class="openDetail===menu.id ? 'rotate-180 text-primary' : ''"
                                fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <polyline points="6 9 12 15 18 9"/>
                              </svg>
                            </div>
                          </button>
                          <div x-show="openDetail===menu.id" x-transition class="border-t border-white/5 bg-black/30">
                            <div class="p-5 pl-16 grid grid-cols-1 sm:grid-cols-3 gap-5">
                              <template x-for="det in menu.details" :key="det.t">
                                <div>
                                  <div class="text-[9px] uppercase font-black tracking-widest text-primary/60 mb-1.5" x-text="det.t"></div>
                                  <p class="text-white/55 text-xs leading-relaxed" x-text="det.c"></p>
                                </div>
                              </template>
                            </div>
                          </div>
                        </div>
                      </template>
                    </div>
                  </div>

                  <!-- TAB: Extras Traiteur -->
                  <div x-show="step2tab==='traiteur'">
                    <p class="text-white/35 text-xs mb-6">Planches, tapas et verrines pour compléter votre prestation — cliquez pour sélectionner</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                      <template x-for="item in D.traiteurItems" :key="item.id">
                        <button @click="toggleT(item.id)"
                          class="border transition-all duration-200 overflow-hidden text-left w-full"
                          :class="tsel[item.id] ? 'border-primary/50' : 'border-white/10 hover:border-white/20'">
                          <div class="h-24 overflow-hidden">
                            <img :src="item.img" :alt="item.name"
                              class="w-full h-full object-cover transition-opacity duration-300"
                              :class="tsel[item.id] ? 'opacity-80' : 'opacity-40'" />
                          </div>
                          <div class="p-4">
                            <!-- Checkbox visuel -->
                            <div class="flex items-center gap-2.5 mb-1">
                              <div class="w-4 h-4 border-2 rounded-full flex items-center justify-center shrink-0 transition-colors duration-200"
                                :class="tsel[item.id] ? 'border-primary' : 'border-white/20'">
                                <div class="w-2 h-2 rounded-full bg-primary transition-all duration-200"
                                  :class="tsel[item.id] ? 'opacity-100 scale-100' : 'opacity-0 scale-0'"></div>
                              </div>
                              <span class="font-black text-sm text-white" x-text="item.name"></span>
                            </div>
                            <div class="text-white/35 text-[11px] mb-3 pl-[26px]" x-text="item.desc"></div>
                            <div class="pl-[26px]">
                              <template x-if="!item.surDevis">
                                <span>
                                  <span class="font-black text-sm transition-colors duration-200"
                                    :class="tsel[item.id] ? 'text-primary' : 'text-white/50'"
                                    x-text="item.price.toFixed(2).replace('.',',')+'€'"></span>
                                  <span class="text-white/35 text-[10px] ml-1" x-text="'/ '+item.unit"></span>
                                </span>
                              </template>
                              <template x-if="item.surDevis">
                                <span class="text-white/40 text-xs italic font-semibold">Sur devis</span>
                              </template>
                            </div>
                          </div>
                        </button>
                      </template>
                    </div>
                  </div>

                  <!-- TAB: À la Carte -->
                  <div x-show="step2tab==='carte'">
                    <p class="text-white/35 text-xs mb-6">Composez librement votre braséro — apéritifs et viandes au choix, prix par personne</p>
                    <div class="space-y-8">
                      <div>
                        <div class="text-[9px] uppercase font-black tracking-widest text-primary/60 mb-3">Apéritifs</div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          <template x-for="item in D.carteAperitifs" :key="item.id">
                            <button @click="toggleCarte('ap', item.id)"
                              :class="carte.ap.includes(item.id)
                                ? 'border-primary/60 bg-primary/10 text-primary'
                                : 'border-white/10 text-white/50 hover:border-white/25 hover:text-white'"
                              class="border p-3 text-left flex justify-between items-center transition-all duration-150 gap-3">
                              <span class="text-xs font-bold leading-snug" x-text="item.name"></span>
                              <span class="text-xs font-black shrink-0 opacity-70"
                                x-text="item.price.toFixed(2).replace('.',',')+' €'"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                      <div>
                        <div class="text-[9px] uppercase font-black tracking-widest text-primary/60 mb-3">Viandes</div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          <template x-for="item in D.carteViandes" :key="item.id">
                            <button @click="toggleCarte('vi', item.id)"
                              :class="carte.vi.includes(item.id)
                                ? 'border-primary/60 bg-primary/10 text-primary'
                                : 'border-white/10 text-white/50 hover:border-white/25 hover:text-white'"
                              class="border p-3 text-left flex justify-between items-center transition-all duration-150 gap-3 cursor-pointer">
                              <span class="text-xs font-bold leading-snug" x-text="item.name"></span>
                              <span class="text-xs font-black shrink-0 opacity-70"
                                x-text="item.unit==='devis' ? 'Sur devis' : item.price.toFixed(2).replace('.',',')+' €'"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="flex justify-between pt-2">
                    <button @click="step=1;scrollToForm()" class="btn-ghost">← Retour</button>
                    <button @click="if(ok2()){step=3;scrollToForm()}" :disabled="!ok2()"
                      :class="ok2() ? 'btn-primary cursor-pointer' : 'btn-primary opacity-30 cursor-not-allowed'">
                      Continuer →
                    </button>
                  </div>
                </div>
              </div>

              <!-- ──────────────────────────────────────────
                   STEP 3 — Contact
              ─────────────────────────────────────────── -->
              <div x-show="step===3"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 translate-x-6"
                x-transition:enter-end="opacity-100 translate-x-0">
                <div class="space-y-6">

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label class="f-label">Prénom</label>
                      <input type="text" x-model="ct.prenom" placeholder="Jean" class="f-input placeholder-white/20" />
                    </div>
                    <div>
                      <label class="f-label">Nom</label>
                      <input type="text" x-model="ct.nom" placeholder="Dupont" class="f-input placeholder-white/20" />
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label class="f-label">Email</label>
                      <input type="email" x-model="ct.email" placeholder="jean@email.com" class="f-input placeholder-white/20" />
                    </div>
                    <div>
                      <label class="f-label">Téléphone</label>
