      border: 1px solid rgba(255,255,255,0.10);
      color: #fff; padding: 12px 16px; font-size: 14px;
      outline: none; transition: border-color 0.2s; display: block;
    }
    .f-input:focus { border-color: #F5C518; }
    .a-label {
      font-size: 9px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.4em;
      color: rgba(160,160,160,0.55); margin-bottom: 10px;
    }
