APP_ENV=prod
APP_SECRET=changez_cette_valeur_32_caracteres_minimum_obligatoire

# Base de données MySQL O2switch
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/NOM_BASE?serverVersion=8.0&charset=utf8mb4"

# SMTP O2switch — remplacer avec vos identifiants cPanel
MAILER_DSN=smtp://votre_email%40domaine.fr:motdepasse@mail.o2switch.net:587?encryption=tls&auth_mode=login

# Adresse de notification du boucher (destinataire des nouvelles demandes)
EMAIL_BOUCHER=boucher@son-domaine.fr

# Adresse expéditeur des emails automatiques
EMAIL_FROM=noreply@son-domaine.fr

# Nom affiché dans les emails (ex: dans l'en-tête et la signature)
NOM_BOUCHER="Boucherie Dupont"
