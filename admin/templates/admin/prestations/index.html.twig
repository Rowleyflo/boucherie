{% extends 'base.html.twig' %}

{% block title %}Prestations & Tarifs{% endblock %}
{% block page_title %}Prestations & Tarifs{% endblock %}

{% block topbar_actions %}
{% if is_granted('ROLE_AGENCE') %}
<button @click="$dispatch('open-create-prestation')"
        class="flex items-center gap-2 bg-primary hover:bg-primary-dark text-black font-semibold px-4 py-2 rounded-xl text-sm transition-colors">
    + Nouvelle prestation
</button>
{% endif %}
{% endblock %}

{% block body %}
<div class="space-y-3" x-data="prestationsManager()" @open-create-prestation.window="showCreateForm = true">

    {# ─── FORMULAIRE CRÉATION (ROLE_AGENCE) ──────────── #}
    {% if is_granted('ROLE_AGENCE') %}
    <div x-show="showCreateForm"
         x-transition
         class="bg-dark-2 border border-primary/30 rounded-2xl p-5 mb-4">
        <h3 class="font-serif italic text-xl text-white mb-4">Nouvelle prestation</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
            <input x-model="newPrestation.nom" type="text" placeholder="Nom *"
                   class="bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white placeholder-white/20 focus:border-primary transition-all">
            <input x-model="newPrestation.slug" type="text" placeholder="Slug (ex: mariage)"
                   class="bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white placeholder-white/20 focus:border-primary transition-all">
            <input x-model="newPrestation.icone" type="text" placeholder="Icône emoji (ex: 💍)"
                   class="bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white placeholder-white/20 focus:border-primary transition-all">
        </div>
        <textarea x-model="newPrestation.description" placeholder="Description" rows="2"
                  class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white placeholder-white/20 focus:border-primary transition-all resize-none mb-3"></textarea>
        <div class="flex gap-2">
            <button @click="createPrestation()"
                    class="bg-primary hover:bg-primary-dark text-black font-semibold px-4 py-2 rounded-xl text-sm transition-colors">
                Créer
            </button>
            <button @click="showCreateForm = false"
                    class="bg-white/5 hover:bg-white/10 text-white px-4 py-2 rounded-xl text-sm transition-colors">
                Annuler
            </button>
        </div>
    </div>
    {% endif %}

    {# ─── LISTE DES PRESTATIONS ──────────────────────── #}
    {% for prestation in prestations %}
    <div class="bg-dark-2 border border-white/5 rounded-2xl overflow-hidden"
         x-data="prestationItem({{ prestation.id }}, {{ prestation|json_encode|e('html_attr') }})">

        {# En-tête accordéon #}
        <div class="flex items-center gap-3 px-5 py-4 cursor-pointer hover:bg-white/[0.04] transition-colors"
             @click="open = !open">
            <span class="text-2xl leading-none" x-text="data.icone">{{ prestation.icone }}</span>
            <div class="flex-1 min-w-0">
                <h3 class="font-serif italic text-lg text-white" x-text="data.nom">{{ prestation.nom }}</h3>
                <p class="text-xs text-white/40">{{ prestation.tarifs|length }} tarif{{ prestation.tarifs|length != 1 ? 's' : '' }}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs px-2 py-0.5 rounded font-medium"
                      :class="data.actif ? 'bg-green-900/40 text-green-400 border border-green-700/40' : 'bg-white/[0.04] text-white/40 border border-white/5'">
                    <span x-text="data.actif ? 'Actif' : 'Inactif'">{{ prestation.actif ? 'Actif' : 'Inactif' }}</span>
                </span>
                <svg class="size-4 text-white/40 transition-transform" :class="open ? 'rotate-180' : ''"
                     xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
        </div>

        {# Contenu accordéon #}
        <div x-show="open" x-transition class="border-t border-white/[0.04] px-5 pb-5 pt-4">

            {# Formulaire édition prestation #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                <div>
                    <label class="text-xs text-white/40 uppercase tracking-wider mb-1 block">Nom</label>
                    <input x-model="data.nom" type="text"
                           class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:border-primary transition-all">
                </div>
                <div>
                    <label class="text-xs text-white/40 uppercase tracking-wider mb-1 block">Icône</label>
                    <input x-model="data.icone" type="text"
                           class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:border-primary transition-all">
                </div>
                <div>
                    <label class="text-xs text-white/40 uppercase tracking-wider mb-1 block">Statut</label>
                    <select x-model="data.actif"
                            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:border-primary transition-all">
                        <option :value="true">Actif</option>
                        <option :value="false">Inactif</option>
                    </select>
                </div>
                <div class="sm:col-span-3">
                    <label class="text-xs text-white/40 uppercase tracking-wider mb-1 block">Description</label>
                    <textarea x-model="data.description" rows="2"
                              class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:border-primary transition-all resize-none"></textarea>
                </div>
            </div>
            <div class="flex items-center gap-3 mb-6">
                <button @click="savePrestation()"
                        class="bg-primary hover:bg-primary-dark text-black font-semibold px-4 py-2 rounded-xl text-sm transition-colors">
                    Sauvegarder
                </button>
                <span x-show="savedMsg" class="text-xs text-green-400" x-text="savedMsg"></span>
                {% if is_granted('ROLE_AGENCE') %}
                <button @click="deletePrestation()"
                        class="ml-auto text-xs text-rouge hover:text-red-300 transition-colors">
                    Supprimer cette prestation
                </button>
                {% endif %}
            </div>

            {# Tableau tarifs #}
            <h4 class="font-serif italic text-base text-white mb-3">Tarifs</h4>
            <div class="overflow-x-auto rounded-xl border border-white/[0.04]">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-dark border-b border-white/[0.04] text-white/40 uppercase tracking-wider">
                            <th class="px-3 py-2 text-left font-medium">Libellé</th>
                            <th class="hidden sm:table-cell px-3 py-2 text-left font-medium">Description</th>
                            <th class="px-3 py-2 text-right font-medium">Prix</th>
                            <th class="px-3 py-2 text-center font-medium">Unité</th>
                            <th class="hidden md:table-cell px-3 py-2 text-center font-medium">Min pers.</th>
                            <th class="px-3 py-2 text-center font-medium">Actif</th>
                            <th class="px-3 py-2 text-right font-medium">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.04]">
                        <template x-for="tarif in tarifs" :key="tarif.id">
                            <tr>
                                <td class="px-3 py-2">
                                    <template x-if="!tarif.editing">
                                        <span class="text-white" x-text="tarif.label"></span>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <input x-model="tarif.label" type="text"
                                               class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs focus:border-primary">
                                    </template>
                                </td>
                                <td class="hidden sm:table-cell px-3 py-2 text-white/40 max-w-[140px]">
                                    <template x-if="!tarif.editing">
                                        <span x-text="tarif.description || '—'" class="truncate block"></span>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <input x-model="tarif.description" type="text"
                                               class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs focus:border-primary">
                                    </template>
                                </td>
                                <td class="px-3 py-2 text-right font-mono">
                                    <template x-if="!tarif.editing">
                                        <span class="text-primary font-semibold" x-text="tarif.prix_formatted || tarif.prix_base + ' €'"></span>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <input x-model="tarif.prix_base" type="number" step="0.01" min="0"
                                               class="w-24 bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs text-right focus:border-primary">
                                    </template>
                                </td>
                                <td class="px-3 py-2 text-center text-white/40">
                                    <template x-if="!tarif.editing">
                                        <span x-text="uniteLabel(tarif.unite)"></span>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <select x-model="tarif.unite"
                                                class="bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs focus:border-primary">
                                            {% for val, lbl in unites %}
                                            <option value="{{ val }}">{{ lbl }}</option>
                                            {% endfor %}
                                        </select>
                                    </template>
                                </td>
                                <td class="hidden md:table-cell px-3 py-2 text-center text-white/40">
                                    <template x-if="!tarif.editing">
                                        <span x-text="tarif.min_personnes || '—'"></span>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <input x-model="tarif.min_personnes" type="number" min="0"
                                               class="w-16 bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs text-center focus:border-primary">
                                    </template>
                                </td>
                                <td class="px-3 py-2 text-center">
                                    <button @click="toggleActifTarif(tarif)"
                                            :class="tarif.actif ? 'text-green-400' : 'text-white/40/40'"
                                            class="transition-colors">
                                        <span x-text="tarif.actif ? '●' : '○'"></span>
                                    </button>
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <template x-if="!tarif.editing">
                                        <button @click="tarif.editing = true"
                                                class="text-primary hover:text-primary-dark transition-colors mr-2">Éditer</button>
                                    </template>
                                    <template x-if="tarif.editing">
                                        <button @click="saveTarif(tarif)"
                                                class="text-green-400 hover:text-green-300 transition-colors mr-2">✓</button>
                                    </template>
                                    <button @click="deleteTarif(tarif)"
                                            class="text-rouge/70 hover:text-rouge transition-colors">✕</button>
                                </td>
                            </tr>
                        </template>

                        {# Ligne ajout nouveau tarif #}
                        <tr x-show="showAddTarif">
                            <td class="px-3 py-2">
                                <input x-model="newTarif.label" type="text" placeholder="Libellé *"
                                       class="w-full bg-white/5 border border-primary/40 rounded px-2 py-1 text-white text-xs focus:border-primary">
                            </td>
                            <td class="hidden sm:table-cell px-3 py-2">
                                <input x-model="newTarif.description" type="text" placeholder="Description"
                                       class="w-full bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs focus:border-primary">
                            </td>
                            <td class="px-3 py-2">
                                <input x-model="newTarif.prix_base" type="number" step="0.01" min="0" placeholder="0.00"
                                       class="w-24 bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs text-right focus:border-primary">
                            </td>
                            <td class="px-3 py-2">
                                <select x-model="newTarif.unite"
                                        class="bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs focus:border-primary">
                                    {% for val, lbl in unites %}
                                    <option value="{{ val }}">{{ lbl }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td class="hidden md:table-cell px-3 py-2">
                                <input x-model="newTarif.min_personnes" type="number" min="0" placeholder="—"
                                       class="w-16 bg-white/5 border border-white/10 rounded px-2 py-1 text-white text-xs text-center focus:border-primary">
                            </td>
                            <td></td>
                            <td class="px-3 py-2 text-right">
                                <button @click="createTarif()"
                                        class="text-green-400 hover:text-green-300 transition-colors mr-2">✓ Ajouter</button>
                                <button @click="showAddTarif = false; newTarif = {label:'',description:'',prix_base:'0.00',unite:'par_personne',min_personnes:null}"
                                        class="text-rouge/70 hover:text-rouge transition-colors">Annuler</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <button @click="showAddTarif = true"
                    class="mt-3 flex items-center gap-1.5 text-xs text-primary hover:text-primary-dark transition-colors font-medium">
                + Ajouter un tarif
            </button>
        </div>

    </div>
    {% else %}
    <p class="text-center text-white/40 py-12">Aucune prestation configurée.</p>
    {% endfor %}

</div>
{% endblock %}

{% block scripts %}
<script>
const UNITES = {
    par_personne: 'Par personne',
    forfait: 'Forfait',
    au_kg: 'Au kg',
};

function prestationsManager() {
    return {
        showCreateForm: false,
        newPrestation: { nom: '', slug: '', description: '', icone: '🍖', actif: true },
        async createPrestation() {
            const res = await apiFetch('/admin/prestations', {
                method: 'PUT',
                body: JSON.stringify(this.newPrestation),
            });
            const data = await res.json();
            if (data.success) {
                showToast('Prestation créée.', 'success');
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(data.error || 'Erreur.', 'error');
            }
        },
    };
}

function prestationItem(id, initial) {
    const raw = typeof initial === 'string' ? JSON.parse(initial) : initial;
    return {
        id,
        open: false,
        data: {
            nom:         raw.nom,
            description: raw.description,
            icone:       raw.icone,
            actif:       raw.actif,
        },
        tarifs:       (raw.tarifs || []).map(t => ({ ...t, editing: false })),
        savedMsg:     '',
        showAddTarif: false,
        newTarif:     { label: '', description: '', prix_base: '0.00', unite: 'par_personne', min_personnes: null },

        uniteLabel(val) { return UNITES[val] || val; },

        async savePrestation() {
            const res = await apiFetch(`/admin/prestations/${this.id}`, {
                method: 'POST',
                body: JSON.stringify(this.data),
            });
            const d = await res.json();
            if (d.success) {
                this.savedMsg = '✓ Sauvegardé le ' + d.updated_at;
                showToast('Prestation mise à jour.', 'success');
                setTimeout(() => { this.savedMsg = ''; }, 4000);
            } else {
                showToast(d.error || 'Erreur.', 'error');
            }
        },

        async deletePrestation() {
            if (!confirm('Supprimer cette prestation et tous ses tarifs ?')) return;
            const res = await apiFetch(`/admin/prestations/${this.id}`, { method: 'DELETE' });
            const d = await res.json();
            if (d.success) {
                showToast('Prestation supprimée.', 'success');
                setTimeout(() => location.reload(), 800);
            }
        },

        async saveTarif(tarif) {
            const res = await apiFetch(`/admin/prestations/tarifs/${tarif.id}`, {
                method: 'POST',
                body: JSON.stringify({
                    label:          tarif.label,
                    description:    tarif.description,
                    prix_base:      tarif.prix_base,
                    unite:          tarif.unite,
                    min_personnes:  tarif.min_personnes,
                    max_personnes:  tarif.max_personnes,
                    actif:          tarif.actif,
                }),
            });
            const d = await res.json();
            if (d.success) {
                tarif.prix_formatted = d.prix_formatted;
                tarif.editing = false;
                showToast('Tarif mis à jour.', 'success');
            } else {
                showToast(d.error || 'Erreur.', 'error');
            }
        },

        async toggleActifTarif(tarif) {
            tarif.actif = !tarif.actif;
            await this.saveTarif(tarif);
        },

        async createTarif() {
            if (!this.newTarif.label.trim()) { showToast('Le libellé est obligatoire.', 'error'); return; }
            const res = await apiFetch(`/admin/prestations/${this.id}/tarifs`, {
                method: 'PUT',
                body: JSON.stringify(this.newTarif),
            });
            const d = await res.json();
            if (d.success) {
                this.tarifs.push({ ...d, ...this.newTarif, actif: true, editing: false });
                this.showAddTarif = false;
                this.newTarif = { label: '', description: '', prix_base: '0.00', unite: 'par_personne', min_personnes: null };
                showToast('Tarif ajouté.', 'success');
            } else {
                showToast(d.error || 'Erreur.', 'error');
            }
        },

        async deleteTarif(tarif) {
            if (!confirm(`Supprimer le tarif "${tarif.label}" ?`)) return;
            const res = await apiFetch(`/admin/prestations/tarifs/${tarif.id}`, { method: 'DELETE' });
            const d = await res.json();
            if (d.success) {
                this.tarifs = this.tarifs.filter(t => t.id !== tarif.id);
                showToast('Tarif supprimé.', 'success');
            }
        },
    };
}
</script>
{% endblock %}
