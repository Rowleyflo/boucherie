{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block head_extra %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block body %}

{# ─── CARTES STATUTS ─────────────────────────────────── #}
<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mb-6">
    {% set statut_icons = { 'nouveau': '🆕', 'lu': '👁️', 'en_attente': '⏳', 'accepte': '✅', 'refuse': '❌' } %}
    {% set statut_colors = { 'nouveau': 'border-rouge/40 bg-rouge/8', 'lu': 'border-white/8 bg-white/[0.03]', 'en_attente': 'border-yellow-600/40 bg-yellow-900/15', 'accepte': 'border-green-700/40 bg-green-900/15', 'refuse': 'border-white/8 bg-white/[0.03]' } %}
    {% set statut_text = { 'nouveau': 'text-rouge', 'lu': 'text-white/50', 'en_attente': 'text-yellow-400', 'accepte': 'text-green-400', 'refuse': 'text-white/30' } %}

    {% for slug, label in constant('App\\Entity\\Devis::STATUTS') %}
    <a href="{{ path('admin_devis_index', { statut: slug }) }}"
       class="relative flex flex-col items-start p-4 rounded-xl border transition-all hover:scale-[1.02] hover:border-primary/30
              {{ statut_colors[slug] ?? 'border-white/8 bg-white/[0.03]' }}">
        <span class="text-xl mb-3 leading-none">{{ statut_icons[slug] ?? '•' }}</span>
        <span class="text-3xl font-serif italic font-semibold {{ statut_text[slug] ?? 'text-white' }}">
            {{ counts_by_statut[slug] ?? 0 }}
        </span>
        <span class="text-[10px] text-white/40 uppercase tracking-widest mt-1 font-black">{{ label }}</span>
    </a>
    {% endfor %}
</div>

{# ─── GRAPHIQUE + DERNIERS DEVIS ─────────────────────── #}
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

    {# Graphique 30 jours #}
    <div class="xl:col-span-2 bg-dark-2 border border-white/5 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-5">
            <h2 class="font-serif italic text-xl text-white">Activité — 30 derniers jours</h2>
            <span class="text-[10px] text-white/40 uppercase tracking-widest font-black bg-white/5 px-3 py-1.5 rounded-full">{{ total }} devis total</span>
        </div>
        <div class="relative h-52">
            <canvas id="activityChart"></canvas>
        </div>
    </div>

    {# Derniers devis #}
    <div class="bg-dark-2 border border-white/5 rounded-2xl p-6 flex flex-col">
        <div class="flex items-center justify-between mb-5">
            <h2 class="font-serif italic text-xl text-white">Derniers devis</h2>
            <a href="{{ path('admin_devis_index') }}" class="text-[10px] text-primary hover:text-primary-dark uppercase tracking-widest font-black transition-colors">
                Voir tout →
            </a>
        </div>

        <div class="flex-1 space-y-1">
            {% for devis in derniers_devis %}
            {% set colors = { 'rouge': 'bg-rouge/15 text-red-300', 'gray': 'bg-white/5 text-white/40', 'yellow': 'bg-yellow-900/30 text-yellow-300', 'green': 'bg-green-900/30 text-green-300', 'slate': 'bg-white/5 text-white/40' } %}
            <a href="{{ path('admin_devis_show', { id: devis.id }) }}"
               class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/[0.04] transition-colors group">
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-white truncate group-hover:text-primary transition-colors">
                        {{ devis.clientPrenom }} {{ devis.clientNom }}
                    </p>
                    <p class="text-[10px] text-white/30 font-black uppercase tracking-wide">
                        {{ devis.reference }} · {{ devis.prestationNom|slice(0, 18) }}{% if devis.prestationNom|length > 18 %}…{% endif %}
                    </p>
                </div>
                <span class="shrink-0 text-[10px] px-2.5 py-1 rounded-full font-black uppercase tracking-wide {{ colors[devis.statutColor] ?? 'bg-white/5 text-white/40' }}">
                    {{ devis.statutLabel }}
                </span>
            </a>
            {% else %}
            <p class="text-white/30 text-sm text-center py-8">Aucun devis pour le moment.</p>
            {% endfor %}
        </div>

        <div class="mt-4 pt-4 border-t border-white/5">
            <a href="{{ path('admin_devis_index', { statut: 'nouveau' }) }}"
               class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-primary/10 border border-primary/20
                      text-primary text-[11px] font-black uppercase tracking-widest hover:bg-primary/20 transition-colors">
                <span class="badge-pulse">●</span> Voir les nouveaux ({{ counts_by_statut.nouveau ?? 0 }})
            </a>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
const ctx = document.getElementById('activityChart');
if (ctx) {
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: {{ chart_labels|raw }},
            datasets: [{
                label: 'Devis reçus',
                data: {{ chart_data|raw }},
                borderColor: '#F5C518',
                backgroundColor: 'rgba(245,197,24,0.06)',
                borderWidth: 2,
                pointBackgroundColor: '#F5C518',
                pointBorderColor: '#0a0a0a',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6,
                tension: 0.35,
                fill: true,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f0f0f',
                    borderColor: '#F5C518',
                    borderWidth: 1,
                    titleColor: '#ffffff',
                    bodyColor: 'rgba(255,255,255,0.5)',
                    callbacks: {
                        title: (items) => {
                            const d = new Date(items[0].label);
                            return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
                        },
                        label: (item) => ` ${item.parsed.y} devis`
                    }
                }
            },
            scales: {
                x: {
                    ticks: {
                        color: '#6b6b69',
                        font: { size: 10, family: 'DM Sans' },
                        maxTicksLimit: 8,
                        callback: function(val, idx) {
                            const d = new Date(this.getLabelForValue(val));
                            return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
                        }
                    },
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    border: { color: 'rgba(255,255,255,0.06)' },
                },
                y: {
                    beginAtZero: true,
                    ticks: { color: '#6b6b69', font: { size: 11, family: 'DM Sans' }, precision: 0 },
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    border: { color: 'rgba(255,255,255,0.06)' },
                }
            }
        }
    });
}
</script>
{% endblock %}
