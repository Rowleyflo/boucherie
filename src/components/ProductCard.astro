---
export interface Props {
  name: string;
  description: string;
  category?: string;
  featured?: boolean;
  image?: string;
}
const { name, description, category, featured = false, image } = Astro.props;
---

<article class:list={[
  'dark-card group relative overflow-hidden transition-all duration-300',
  'hover:border-dark-500',
  featured && 'ring-1 ring-rouge-600/30',
]}>
  {/* Bande de couleur en haut pour les produits featured */}
  {featured && <div class="absolute top-0 left-0 right-0 h-px bg-rouge-600"></div>}

  <div class="p-8">
    {/* Icône décorative */}
    <div class="w-10 h-10 mb-6 flex items-center justify-center border border-dark-500 text-cream-500 group-hover:border-rouge-600/50 group-hover:text-rouge-600 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
    </div>

    {category && <p class="section-label text-cream-600 mb-3">{category}</p>}
    <h3 class="font-serif text-xl text-cream-100 mb-3">{name}</h3>
    <p class="text-cream-500 text-sm leading-relaxed">{description}</p>
  </div>
</article>
