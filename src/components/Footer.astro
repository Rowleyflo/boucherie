---
import { contact } from '../data/contact';
import { hours } from '../data/hours';

const footerLinks = [
  { href: '/',           label: 'Accueil' },
  { href: '/boucherie',  label: 'Boucherie' },
  { href: '/charcuterie',label: 'Charcuterie' },
  { href: '/traiteur',   label: 'Traiteur' },
  { href: '/a-propos',   label: 'À Propos' },
  { href: '/contact',    label: 'Contact' },
];
---

<footer class="bg-dark-950 border-t border-dark-700">

  <!-- Barre de contact (style Haverick) -->
  <div class="bg-dark-800 border-b border-dark-700">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <span class="section-label text-cream-600">Téléphone :</span>
        <a href={contact.phone.href} class="font-serif text-cream-200 text-lg hover:text-cream-100 transition-colors">
          {contact.phone.display}
        </a>
        <span class="hidden sm:block text-dark-500">|</span>
        <a href={contact.email.href} class="section-label text-cream-500 hover:text-cream-300 transition-colors">
          {contact.email.display}
        </a>
      </div>
      <a href="/contact" class="btn-rouge text-[10px]">
        Nous contacter
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Footer principal -->
  <div class="max-w-7xl mx-auto px-6 py-14 grid grid-cols-1 md:grid-cols-3 gap-12">

    <!-- Colonne 1 : Logo + texte -->
    <div>
      <a href="/" class="block mb-4">
        <span class="font-serif text-2xl font-semibold text-cream-100">Chez Guillaume</span>
        <span class="block text-cream-500 mt-1" style="font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;">
          Boucher · Charcutier · Traiteur
        </span>
      </a>
      <p class="text-cream-500 text-sm leading-relaxed max-w-xs">
        Boucherie artisanale à Montbeton depuis plusieurs années. Viandes fraîches de producteurs locaux, charcuteries maison, prestations traiteur.
      </p>
      <div class="flex items-center gap-4 mt-6">
        <a href={contact.social.facebook} target="_blank" rel="noopener noreferrer"
          class="text-cream-600 hover:text-cream-300 transition-colors" aria-label="Facebook">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Colonne 2 : Navigation -->
    <div>
      <h3 class="section-label text-cream-400 mb-5">Navigation</h3>
      <ul class="space-y-3">
        {footerLinks.map(link => (
          <li>
            <a href={link.href} class="text-cream-500 text-sm hover:text-cream-200 transition-colors">
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/traiteur/sur-mesure" class="text-rouge-600 text-sm hover:text-rouge-500 transition-colors font-medium">
            Commander un menu sur mesure
          </a>
        </li>
      </ul>
    </div>

    <!-- Colonne 3 : Horaires + adresse -->
    <div>
      <h3 class="section-label text-cream-400 mb-5">Horaires</h3>
      <ul class="space-y-2 mb-6">
        {hours.map(h => (
          <li class="flex justify-between text-sm">
            <span class="text-cream-500">{h.day}</span>
            {h.closed
              ? <span class="text-rouge-600">Fermé</span>
              : <span class="text-cream-300">
                  {h.slots!.map(s => `${s.open}–${s.close}`).join(' / ')}
                </span>
            }
          </li>
        ))}
      </ul>
      <address class="not-italic text-cream-500 text-sm leading-relaxed">
        {contact.address.street}<br />
        {contact.address.zip} {contact.address.city}<br />
        <a href={contact.address.googleMaps} target="_blank" rel="noopener noreferrer"
          class="text-cream-400 hover:text-cream-200 transition-colors mt-1 inline-block">
          Voir sur Google Maps →
        </a>
      </address>
    </div>
  </div>

  <!-- Bas de footer -->
  <div class="border-t border-dark-700 py-5">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-cream-600" style="font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;">
      <span>© {new Date().getFullYear()} Chez Guillaume — Boucherie Montbeton</span>
      <span>SIRET 97789531700021</span>
    </div>
  </div>

</footer>
