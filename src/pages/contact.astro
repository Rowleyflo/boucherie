---
import Layout from '../layouts/Layout.astro';
import HoursTable from '../components/HoursTable.astro';
import { contact } from '../data/contact';
---

<Layout
  title="Contact — Horaires & Accès"
  description="Contactez la boucherie Chez Guillaume à Montbeton. 496 Route de Montauban, 82290 Montbeton. Tél : 05 63 27 29 98. Ouvert du mardi au dimanche."
>

  <!-- Hero -->
  <section class="relative h-64 lg:h-80 flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0"
         style="background-color: #0a0a0a; background-image: url('/images/boutique-devanture.jpg'); background-size: cover; background-position: center;">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-950/60 to-dark-950/95"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-12 w-full">
      <p class="section-label text-rouge-600 mb-3">Chez Guillaume</p>
      <h1 class="font-serif italic text-cream-100" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">
        Contact & Accès
      </h1>
    </div>
  </section>


  <!-- Contenu principal -->
  <section class="bg-dark-900 py-20">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12">

      <!-- Colonne gauche : infos + horaires -->
      <div class="space-y-8">

        <!-- Infos contact -->
        <div class="dark-card p-8">
          <p class="section-label text-cream-500 mb-6">Nos coordonnées</p>
          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 flex items-center justify-center border border-dark-500 text-cream-500 flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="section-label text-cream-600 mb-1">Adresse</p>
                <address class="not-italic text-cream-300">
                  {contact.address.street}<br />
                  {contact.address.zip} {contact.address.city}
                </address>
                <a href={contact.address.googleMaps} target="_blank" rel="noopener noreferrer"
                  class="link-serif text-xs mt-1 inline-block">
                  Voir sur Google Maps →
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="w-10 h-10 flex items-center justify-center border border-dark-500 text-cream-500 flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="section-label text-cream-600 mb-1">Téléphone</p>
                <a href={contact.phone.href} class="text-cream-200 hover:text-rouge-500 transition-colors font-medium">
                  {contact.phone.display}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="w-10 h-10 flex items-center justify-center border border-dark-500 text-cream-500 flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="section-label text-cream-600 mb-1">Email</p>
                <a href={contact.email.href} class="text-cream-300 hover:text-cream-100 transition-colors text-sm break-all">
                  {contact.email.display}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="w-10 h-10 flex items-center justify-center border border-dark-500 text-cream-500 flex-shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <div>
                <p class="section-label text-cream-600 mb-1">Facebook</p>
                <a href={contact.social.facebook} target="_blank" rel="noopener noreferrer"
                  class="text-cream-300 hover:text-cream-100 transition-colors text-sm">
                  Boucherie Chez Guillaume
                </a>
              </div>
            </li>
          </ul>
        </div>

        <!-- Horaires -->
        <HoursTable />

        <!-- Map embed placeholder -->
        <div class="dark-card overflow-hidden">
          <div class="h-48 bg-dark-700 flex items-center justify-center">
            <a href={contact.address.googleMaps} target="_blank" rel="noopener noreferrer"
              class="flex flex-col items-center gap-2 text-cream-500 hover:text-cream-300 transition-colors">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="section-label">Voir sur Google Maps</span>
            </a>
          </div>
          <div class="p-5 border-t border-dark-600">
            <p class="text-cream-500 text-sm">
              <span class="text-cream-300 font-medium">496 Route de Montauban</span> — 82290 Montbeton
            </p>
          </div>
        </div>
      </div>

      <!-- Colonne droite : formulaire de contact -->
      <div>
        <div class="dark-card p-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-px bg-rouge-600"></div>

          <p class="section-label text-rouge-600 mb-2">Formulaire de contact</p>
          <h2 class="font-serif italic text-cream-100 text-2xl mb-6">
            Envoyez-nous un message
          </h2>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
            x-data="{ submitted: false }"
            @submit.prevent="
              const form = $event.target;
              const data = new FormData(form);
              fetch('https://api.web3forms.com/submit', { method: 'POST', body: data })
                .then(r => r.json())
                .then(d => { if (d.success) submitted = true });
            "
          >
            <input type="hidden" name="access_key" value={contact.web3forms.accessKey} />
            <input type="hidden" name="subject" value="Message depuis le site — Chez Guillaume" />
            <input type="hidden" name="from_name" value="Site Chez Guillaume" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <div x-show="!submitted" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="section-label text-cream-600 block mb-1.5">Nom *</label>
                  <input type="text" name="nom" required
                    class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                    placeholder="Votre nom" />
                </div>
                <div>
                  <label class="section-label text-cream-600 block mb-1.5">Téléphone</label>
                  <input type="tel" name="telephone"
                    class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                    placeholder="06 xx xx xx xx" />
                </div>
              </div>

              <div>
                <label class="section-label text-cream-600 block mb-1.5">Email *</label>
                <input type="email" name="email" required
                  class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                  placeholder="votre@email.fr" />
              </div>

              <div>
                <label class="section-label text-cream-600 block mb-1.5">Sujet</label>
                <select name="sujet"
                  class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors">
                  <option value="">Sélectionner...</option>
                  <option>Renseignement produits</option>
                  <option>Commande spéciale</option>
                  <option>Réservation traiteur</option>
                  <option>Livraison</option>
                  <option>Autre</option>
                </select>
              </div>

              <div>
                <label class="section-label text-cream-600 block mb-1.5">Message *</label>
                <textarea name="message" rows="5" required
                  class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors resize-none placeholder:text-cream-600"
                  placeholder="Votre message..."></textarea>
              </div>

              <button type="submit" class="btn-rouge w-full justify-center">
                Envoyer le message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </button>

              <p class="text-cream-600 text-xs text-center">
                Réponse sous 24–48h · Appel préféré pour les commandes urgentes
              </p>
            </div>

            <!-- Confirmation -->
            <div x-show="submitted" class="text-center py-8">
              <div class="w-14 h-14 rounded-full bg-rouge-600/20 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-rouge-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="font-serif italic text-cream-100 text-xl mb-2">Message envoyé !</h3>
              <p class="text-cream-400 text-sm">Nous vous répondrons dans les plus brefs délais.</p>
            </div>

          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>
