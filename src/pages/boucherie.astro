---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories } from '../data/products';
import { contact } from '../data/contact';

const boucherieProducts = products.filter(p => p.category === 'boucherie');
---

<Layout
  title="Boucherie — Viandes Fraîches Locales"
  description="Découvrez notre sélection de viandes fraîches chez Guillaume à Montbeton. Bœuf, veau, agneau, porc, volaille — issus d'éleveurs locaux du Tarn-et-Garonne."
>

  <!-- Hero page interne -->
  <section class="relative min-h-[55vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0"
         style="background-color: #1a0a0a; background-image: url('/images/viande-boeuf.jpg'); background-size: cover; background-position: center;">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-950/60 via-dark-950/40 to-dark-950/95"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 w-full">
      <p class="section-label text-rouge-600 mb-4">Chez Guillaume</p>
      <h1 class="font-serif italic text-cream-100 leading-tight mb-4" style="font-size: clamp(3rem, 6vw, 5.5rem);">
        Boucherie
      </h1>
      <div class="divider"></div>
      <p class="text-cream-400 max-w-xl text-lg">{categories.boucherie.description}</p>
    </div>
  </section>


  <!-- Intro -->
  <section class="bg-dark-900 py-20">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="section-label text-cream-500 mb-4">Notre sélection</p>
        <h2 class="font-serif italic text-cream-100 text-3xl lg:text-4xl mb-6 leading-snug">
          Viandes fraîches,<br />producteurs locaux
        </h2>
        <div class="divider"></div>
        <p class="text-cream-400 leading-relaxed mb-4">
          Chaque matin, Guillaume sélectionne ses viandes auprès d'éleveurs de la région — Tarn-et-Garonne et alentours. Chaque pièce est découpée sur place, dans notre laboratoire, selon vos besoins.
        </p>
        <p class="text-cream-500 leading-relaxed mb-8">
          Découpe personnalisée, conseils de cuisson, préparations sur commande — nous sommes là pour vous accompagner dans le choix de votre viande.
        </p>
        <a href={contact.phone.href} class="btn-rouge">
          Commander par téléphone
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </a>
      </div>

      <!-- Image mise en avant -->
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden"
             style="background-color: #1a0a0a; background-image: url('/images/guillaume-decoupe.jpg'); background-size: cover; background-position: center;">
        </div>
        <!-- Label badge -->
        <div class="absolute -bottom-4 -left-4 dark-card px-6 py-4 border-l-2 border-rouge-600">
          <p class="section-label text-rouge-600 mb-1">Traçabilité</p>
          <p class="text-cream-200 text-sm font-medium">Producteurs locaux 82</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Grille produits -->
  <section class="bg-dark-800 py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-12">
        <p class="section-label text-cream-500 mb-3">Nos viandes</p>
        <h2 class="font-serif italic text-cream-100 text-3xl">Au comptoir</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {boucherieProducts.map(p => (
          <ProductCard
            name={p.name}
            description={p.description}
            featured={p.featured}
          />
        ))}
      </div>

      <div class="mt-12 dark-card p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="section-label text-cream-500 mb-2">Commande spéciale</p>
          <h3 class="font-serif text-cream-100 text-xl">Vous avez un besoin particulier ?</h3>
          <p class="text-cream-500 text-sm mt-2">Découpe sur mesure, commande en gros, préparation spécifique — appelez-nous.</p>
        </div>
        <a href={contact.phone.href} class="btn-rouge flex-shrink-0">
          {contact.phone.display}
        </a>
      </div>
    </div>
  </section>

  <!-- Lien vers charcuterie -->
  <section class="bg-dark-900 py-16 border-t border-dark-700">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="section-label text-cream-500 mb-2">Également chez nous</p>
        <h3 class="font-serif italic text-cream-100 text-2xl">Charcuterie & Épicerie Fine</h3>
      </div>
      <a href="/charcuterie" class="btn-outline flex-shrink-0">
        Découvrir →
      </a>
    </div>
  </section>

</Layout>
