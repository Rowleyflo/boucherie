---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { contact } from '../../data/contact';

export async function getStaticPaths() {
  const menus = await getCollection('menus');
  return menus.map(menu => ({
    params: { slug: menu.slug },
    props:  { menu },
  }));
}

const { menu } = Astro.props;
const { Content } = await menu.render();
const d = menu.data;
---

<Layout
  title={`${d.title} — Traiteur`}
  description={`${d.description} À partir de ${d.pricePerPerson}€ par personne. Minimum ${d.minPeople} personnes. Réservez en ligne chez Guillaume à Montbeton.`}
>

  <!-- Hero menu -->
  <section class="relative min-h-[50vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0"
         style={`background-color: #0a0808; background-image: url('${d.image ?? '/images/traiteur-brazero.jpg'}'); background-size: cover; background-position: center;`}>
      <div class="absolute inset-0 bg-gradient-to-b from-dark-950/40 via-dark-950/30 to-dark-950/95"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-14 w-full">
      <a href="/traiteur" class="link-serif flex items-center gap-2 mb-6 text-xs">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        Retour aux menus
      </a>
      <p class="section-label text-rouge-600 mb-3">{d.tag}</p>
      <h1 class="font-serif italic text-cream-100 leading-tight mb-4" style="font-size: clamp(2.5rem, 5vw, 5rem);">
        {d.title}
      </h1>
      <div class="divider"></div>
    </div>
  </section>


  <!-- Contenu menu -->
  <section class="bg-dark-900 py-20">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- Détail du menu (2/3) -->
      <div class="lg:col-span-2">

        <!-- Prix + infos -->
        <div class="dark-card p-6 mb-8 flex flex-wrap gap-8">
          <div>
            <span class="section-label text-cream-600 block mb-1">Prix</span>
            <span class="font-serif text-3xl text-cream-100">{d.pricePerPerson}€</span>
            <span class="text-cream-500 text-sm"> / personne</span>
          </div>
          <div>
            <span class="section-label text-cream-600 block mb-1">Minimum</span>
            <span class="text-cream-200">{d.minPeople} personnes</span>
          </div>
          {d.maxPeople && (
            <div>
              <span class="section-label text-cream-600 block mb-1">Maximum</span>
              <span class="text-cream-200">{d.maxPeople} personnes</span>
            </div>
          )}
          {d.duration && (
            <div>
              <span class="section-label text-cream-600 block mb-1">Durée</span>
              <span class="text-cream-200">{d.duration}</span>
            </div>
          )}
        </div>

        <!-- Composition -->
        <div class="space-y-8">
          <!-- Entrées -->
          <div class="dark-card p-7">
            <p class="section-label text-cream-500 mb-4">Entrées</p>
            <ul class="space-y-2">
              {d.starters.map(item => (
                <li class="flex items-start gap-3 text-cream-300 text-sm">
                  <span class="w-1 h-1 rounded-full bg-rouge-600 flex-shrink-0 mt-2"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Plats principaux -->
          <div class="dark-card p-7">
            <p class="section-label text-cream-500 mb-4">Plats principaux</p>
            <ul class="space-y-2">
              {d.mains.map(item => (
                <li class="flex items-start gap-3 text-cream-300 text-sm">
                  <span class="w-1 h-1 rounded-full bg-rouge-600 flex-shrink-0 mt-2"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Accompagnements -->
          {d.sides && d.sides.length > 0 && (
            <div class="dark-card p-7">
              <p class="section-label text-cream-500 mb-4">Accompagnements</p>
              <ul class="space-y-2">
                {d.sides.map(item => (
                  <li class="flex items-start gap-3 text-cream-300 text-sm">
                    <span class="w-1 h-1 rounded-full bg-rouge-600 flex-shrink-0 mt-2"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Desserts -->
          {d.desserts && d.desserts.length > 0 && (
            <div class="dark-card p-7">
              <p class="section-label text-cream-500 mb-4">Desserts</p>
              <ul class="space-y-2">
                {d.desserts.map(item => (
                  <li class="flex items-start gap-3 text-cream-300 text-sm">
                    <span class="w-1 h-1 rounded-full bg-rouge-600 flex-shrink-0 mt-2"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Inclus -->
          {d.includes && d.includes.length > 0 && (
            <div class="dark-card p-7 border-l-2 border-rouge-600">
              <p class="section-label text-rouge-600 mb-4">Inclus dans la formule</p>
              <ul class="space-y-2">
                {d.includes.map(item => (
                  <li class="flex items-start gap-3 text-cream-300 text-sm">
                    <svg class="w-3 h-3 text-rouge-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Note -->
          {d.note && (
            <div class="dark-card p-6">
              <p class="section-label text-cream-600 mb-3">Note</p>
              <p class="text-cream-500 text-sm leading-relaxed italic">{d.note}</p>
            </div>
          )}

          <!-- Contenu Markdown -->
          <div class="prose prose-invert prose-sm max-w-none text-cream-400
                      prose-headings:font-serif prose-headings:italic prose-headings:text-cream-100
                      prose-strong:text-cream-200 prose-a:text-rouge-500">
            <Content />
          </div>
        </div>
      </div>

      <!-- Formulaire de réservation (1/3) -->
      <div id="reserver" class="lg:col-span-1">
        <div class="dark-card p-7 sticky top-24">
          <div class="absolute top-0 left-0 right-0 h-px bg-rouge-600"></div>
          <p class="section-label text-rouge-600 mb-2">Réservation</p>
          <h2 class="font-serif italic text-cream-100 text-xl mb-6">
            Réserver "{d.title}"
          </h2>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
          >
            <input type="hidden" name="access_key" value={contact.web3forms.accessKey} />
            <input type="hidden" name="subject" value={`Réservation Traiteur — ${d.title}`} />
            <input type="hidden" name="from_name" value="Site Chez Guillaume" />
            <input type="hidden" name="menu" value={d.title} />
            <input type="hidden" name="redirect" value="https://boucheriechezguillaume.fr/merci" />

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Nom complet *</label>
              <input type="text" name="nom" required
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                placeholder="Votre nom" />
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Téléphone *</label>
              <input type="tel" name="telephone" required
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                placeholder="06 xx xx xx xx" />
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Email *</label>
              <input type="email" name="email" required
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                placeholder="votre@email.fr" />
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Date de l'événement *</label>
              <input type="date" name="date" required
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors" />
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Nombre de personnes *</label>
              <input type="number" name="personnes" required min={d.minPeople}
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors placeholder:text-cream-600"
                placeholder={`Min. ${d.minPeople}`} />
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Type d'événement</label>
              <select name="type_evenement"
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors">
                <option value="">Sélectionner...</option>
                <option>Mariage</option>
                <option>Anniversaire</option>
                <option>Entreprise</option>
                <option>Fête de famille</option>
                <option>Autre</option>
              </select>
            </div>

            <div>
              <label class="section-label text-cream-600 block mb-1.5">Message / Précisions</label>
              <textarea name="message" rows="3"
                class="w-full bg-dark-700 border border-dark-500 text-cream-100 px-4 py-3 text-sm focus:outline-none focus:border-rouge-600 transition-colors resize-none placeholder:text-cream-600"
                placeholder="Lieu, besoins particuliers, allergies..."></textarea>
            </div>

            <!-- Honeypot -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <button type="submit" class="btn-rouge w-full justify-center">
              Envoyer ma demande
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </button>

            <p class="text-cream-600 text-xs text-center">
              Nous vous rappelons sous 24h pour confirmer.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>
